@model E_commerce.DTOs.Response.GetProductsResponseDto

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Products</h2>

    <a asp-action="Create" class="btn btn-primary">
        Add Product
    </a>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Products.Any())
                {
                    foreach (var product in Model.Products)
                    {
                        <tr>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(product.CoverImagePath))
                                {
                                    <img src="~/@product.CoverImagePath"
                                         alt="@product.Name"
                                         class="img-thumbnail"
                                         style="width:70px;height:70px;object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Image
                                    </span>
                                }
                            </td>

                            <td>@product.Name</td>

                            <td>@product.CategoryName</td>

                            <td>
                                Rs. @product.Price.ToString("N2")
                            </td>

                            <td>
                                @if (product.Stock <= 5)
                                {
                                    <span class="badge bg-danger"> @product.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"> @product.Stock</span>
                                }
                            </td>

                            <td>
                                @if (product.IsDeleted)
                                {
                                    <span class="badge bg-danger">
                                        Deleted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                            </td>

                            <td class="text-end">

                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                @if (!product.IsDeleted)
                                {
                                    <button class="btn btn-sm btn-outline-danger delete-product-btn" data-id="@product.Id">
                                        Delete
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success restore-product-btn"data-id="@product.Id">
                                        Restore
                                    </button>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No products found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts
{
    <script src="~/js/admin/products.js" asp-append-version="true"></script>
}