<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="d-flex min-vh-100">

        <aside class="bg-dark text-white p-3" style="width:260px;">
            <h4 class="mb-4">Admin Panel</h4>

            <div class="list-group list-group-flush">

                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action">
                    Dashboard
                </a>

                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="list-group-item list-group-item-action">
                    Products
                </a>

                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="list-group-item list-group-item-action">
                    Categories
                </a>

                <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="list-group-item list-group-item-action">
                    Users
                </a>

            </div>

            <hr />

            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light w-100 mb-2">
                Storefront
            </a>

            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger w-100">
                    Logout
                </button>
            </form>
        </aside>

        <main class="flex-grow-1 p-4">

            @if (TempData["Success"] is not null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] is not null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @RenderBody()

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>