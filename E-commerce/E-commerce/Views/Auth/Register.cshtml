@model E_commerce.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Register" method="post" enctype="multipart/form-data">
    
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input asp-for="UploadToken" type="hidden" id="uploadToken" />
    <span asp-validation-for="UploadToken" class="text-danger"></span>

    <div class="form-group mb-3">
        <label asp-for="Image" class="form-label"></label>
        <input asp-for="Image" class="form-control" id="imageInput" accept=".jpg,.jpeg,.png"/>
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <div id="imageInfo" class="border rounded p-3 mb-3" style="display:none">
        <p><strong>Format:</strong> <span id="imageFormat"></span>-</p>
        <p><strong>Resolution:</strong> <span id="imageResolution">-</span></p>
        <p><strong>Size:</strong> <span id="imageSize">-</span></p>
    </div>
        
    <div class="form-group mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button id="registerButton" class="btn btn-primary" type="submit">Register</button>

    <div class="mt-3">
        <span>Already have an account?</span>
        <a asp-action="Login">Login</a>
    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        
        // Wait until HTML has finished loading.
        // This ensures that every element we reference already exists
        document.addEventListener("DOMContentLoaded", () =>{

            // Get references to HTML element that will be updated
            const imageInput = document.getElementById("imageInput");
            const uploadToken = document.getElementById("uploadToken");
            const imageInfo = document.getElementById("imageInfo");
            const imageFormat = document.getElementById("imageFormat");
            const imageResolution = document.getElementById("imageResolution");
            const imageSize = document.getElementById("imageSize");

            // ASP.NET generates an antiforgery token inside the form.
            // We need to send this token with AJAX call so server can verify if the request came from our application.
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // Run this code whenever the user selects a different image.
            imageInput.addEventListener("change", async () => {

                // No file selected.
                if(imageInput.files.length === 0)
                {
                    return;
                }

                uploadToken.value = "";
                imageInfo.style.display = "none";

                // FormData creates a multipart/form-data request in the same format as a normal HTML file upload.
                const formData = new FormData();

                // "image" must match IFormFile parameter in ImageController.
                formData.append("image", imageInput.files[0]);

                try
                {
                    // Upload image to stage 1.
                    // Server validates image, stores it temporarily, parse its metadata, creates an upload attempt, and returns a UploadToken.
                    const response = await fetch("/Image/UploadImage", {

                        method: "POST",
                        headers: {
                            RequestVerificationToken: antiForgeryToken 
                    },
                    body: formData
                    });

                    if (!response.ok)
                    {
                        throw new Error("Upload request failed.");
                    }

                    const result = await response.json();

                    if(result.responseCode === 200)
                    {

                        // Store the UploadToken in the hidden field.
                        // This token will later be submitted with registration form.
                        uploadToken.value = result.uploadToken;

                        // Display the image metadata returned by the server.
                        imageInfo.style.display = "block";

                        imageFormat.textContent = result.fileExtension.toUpperCase();

                        imageResolution.textContent = `${result.width} × ${result.height}`;
                        imageSize.textContent = `${(result.fileSizeBytes / 1024).toFixed(2)} KB`;
                    }
                    else
                    {
                        // Upload failed.
                        // Remove any previous UploadToken because it is no longer valid.
                        uploadToken.value = "";
                        imageInfo.style.display = "none";
                        alert(result.responseMessage);
                    }
                }
                catch
                {
                    // Network/server failure.
                    // Clear everything so registration cannot continue with an invalid upload state.
                    uploadToken.value = "";
                    imageInfo.style.display = "none";
                    alert("An unexpected error occurred while uploading the image.");
                }
            });
        });
    </script>
}
