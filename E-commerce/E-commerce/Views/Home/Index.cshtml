@model List<E_commerce.DTOs.ProductListItemDto>

@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <h2 class="mb-4">Products</h2>

    <div class="row g-4">

        @foreach (var product in Model)
        {
            <div class="col-md-4 col-lg-3">

                <div class="card h-100 shadow-sm">

                    @if (string.IsNullOrEmpty(product.CoverImagePath))
                    {
                        <div class="bg-secondary d-flex align-items-center justify-content-center"
                             style="height:220px;">
                            <span class="text-white fs-4">No Image</span>
                        </div>
                    }
                    else
                    {
                        <img src="@product.CoverImagePath"
                             class="card-img-top"
                             alt="@product.Name"
                             style="height:220px; object-fit:cover;" />
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">@product.Name</h5>

                        <p class="card-text text-muted">
                            @product.Description
                        </p>

                        <h5 class="text-primary mt-auto">
                            Rs. @product.Price.ToString("N2")
                        </h5>

                    </div>

                </div>

            </div>
        }

    </div>

</div>