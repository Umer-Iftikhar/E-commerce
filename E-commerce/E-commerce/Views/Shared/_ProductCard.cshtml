@model E_commerce.DTOs.ProductListItemDto

<div class="col-md-4 col-lg-3">
    <div class="card h-100 shadow-sm">

        @if (string.IsNullOrEmpty(Model.CoverImagePath))
        {
            <div class="bg-secondary d-flex align-items-center justify-content-center"
                 style="height:220px;">
                <span class="text-white">No Image</span>
            </div>
        }
        else
        {
            <img src="@Model.CoverImagePath"
                 class="card-img-top"
                 alt="@Model.Name"
                 style="height:220px; object-fit:cover;" />
        }

        <div class="card-body d-flex flex-column">

            <h5 class="card-title">
                @Model.Name
            </h5>

            <p class="card-text text-muted">
                @Model.Description
            </p>

            <h5 class="text-primary mt-auto">
                Rs. @Model.Price.ToString("N0")
            </h5>

            <div class="d-grid gap-2 mt-3">

                <a asp-controller="Product"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary d-flex align-items-center justify-content-center gap-2">

                    <img src="~/icons/search.svg"
                         class="icon"
                         alt="">

                    <span>View Details</span>

                </a>

                @if (Model.Stock > 0)
                {
                    <button class="btn btn-primary add-to-cart-btn" data-product-id="@Model.Id">
                        <img src="~/icons/cart4.svg" class="icon" alt="">
                        <span class="button-text">Add to Cart</span>
                    </button>
                }
                else
                {
                    <p class="text-danger text-center mb-0 fw-semibold">Out of Stock</p>
                }

            </div>

        </div>

    </div>
</div>

