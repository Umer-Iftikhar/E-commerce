@model List<E_commerce.DTOs.ProductListItemDto>

@if (Model.Any())
{
    @foreach (var product in Model)
    {
        <partial name="_ProductCard" model="product" />
    }
}
else
{
    <div class="col-12">
        <div class="alert alert-info text-center">
            <h5 class="mb-2">No products found</h5>
            <p class="mb-0">
                Try changing your search term, category, or date filter.
            </p>
        </div>
    </div>
}