@model E_commerce.DTOs.Response.GetProfileResponseDto

<div class="profile-sidebar-content">

    <div class="text-center mb-4">

        @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
        {
            <img id="profileAvatar" src="~/@Model.ProfileImagePath" class="rounded-circle profile-avatar" alt="Profile Picture" />
        }
        else
        {
            <img id="profileAvatar" src="~/icons/person-circle.svg" class="rounded-circle profile-avatar" alt="Default Profile Picture" />
        }


        <div class="mt-3">

            <input type="file" id="profileImageInput" class="form-control" accept=".jpg,.jpeg,.png" />

            <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="uploadProfileImageBtn">

                <img src="~/icons/pencil.svg" class="sidebar-icon" alt="Change Picture" />

                Change Picture

            </button>

        </div>


        <input id="profileName" class="form-control" value="@Model.Name" />

        <input id="profileEmail" class="form-control" value="@Model.Email" />

        <button type="button" id="saveProfileBtn" class="btn btn-primary w-100 mt-3 d-none">
            Save Changes
        </button>

    </div>

    <hr />


    <div class="d-grid gap-2">

        <a asp-controller="Order" asp-action="GetOrders" class="btn btn-outline-primary text-start">
            <img src="~/icons/bag-check.svg" class="sidebar-icon" alt="Orders" />
            Orders
        </a>


        <a asp-controller="Profile" asp-action="ChangePassword" class="btn btn-outline-secondary text-start">
            <img src="~/icons/pencil-square.svg" class="sidebar-icon" alt="Change Password" />
            Change Password
        </a>


        <form asp-controller="Auth" asp-action="Logout" method="post" @*id="sidebarLogoutForm"*@>
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-outline-danger w-100 text-start">
                <img src="~/icons/box-arrow-right.svg" class="sidebar-icon" alt="Logout" />
                Logout
            </button>

        </form>

    </div>

</div>