{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ECommerce;Trusted_Connection=true;TrustServerCertificate=True;"
  },

  "Jwt": {
    "SecretKey": "your-long-development-secret-key",
    "Issuer": "E-commerceAPI",
    "Audience": "E-commerceClient",
    "ExpiryMinutes": 1,
    "RefreshTokenExpiryDays": 7
  },

  "ImageStorage": {
    "TempFolder": "uploads/temp",
    "AvatarsFolder": "uploads/avatars",
    "MaxFileSizeBytes": 5242880,
    "UploadTokenExpiryMinutes": 15
  }
}
